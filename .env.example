# PitWall AI — Environment Variables
# Copy this to .env and fill in your values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pitwall_ai
DB_USER=pitwall_user
DB_PASSWORD=pitwall_pass

# API
DEBUG=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Vercel: set NEXT_PUBLIC_API_URL to the public Render backend URL, including
# /api/v1, then redeploy so Next.js includes it in the browser bundle.
# Example: https://your-render-service.onrender.com/api/v1
